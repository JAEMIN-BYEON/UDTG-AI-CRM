generator client {
  provider = "prisma-client-js"
}

// P1은 SQLite로 개발, 운영 전환 시 postgresql로 변경 (GCP Cloud SQL)
// 접속 URL은 prisma.config.ts / PrismaClient 어댑터에서 관리 (Prisma 7)
datasource db {
  provider = "sqlite"
}

// 물량 마스터 — 운영본부 관리 (설계서 §6.1)
model Listing {
  id                 String   @id @default(cuid())
  brand              String // 다이소, CU, GS25, 쿠팡 간선, 웰스토리 ...
  category           String // 상온배송 | 저온배송 | 간선 | 식자재
  region             String // 콤마 구분 지역 목록 (예: "용인,수원,화성")
  workHours          String // 업무시간 (예: "06:00-15:00")
  startTime          String   @default("") // 출근시간 (예: "05~06시") — 8.10 개편
  shift              String // 주간 | 야간 | 격일 (출근시간에서 자동 유추 — 폼 미노출)
  payStructure       String // 완제 | 무제 | 매출제
  fee                String   @default("") // 운송료 원문 (예: "완제 610만원") — 8.10 개편
  incomeMin          Int // 운송료에서 자동 추출한 최소 금액 (만원) — 추천 점수용 내부값
  incomeMax          Int // 운송료에서 자동 추출한 최대 금액 (만원) — 추천 점수용 내부값
  physicalLoad       Int // 상하차 강도 1(약)~5(강)
  loadType           String // 상차방식 (롤테이너 | 박스 | 파렛트 ...)
  unloadMethod       String   @default("") // 하차방식 — 8.10 개편
  extraPay           String   @default("") // 기타수당 — 8.10 개편
  workDays           String   @default("") // 운행일수 (예: "26일") — 8.10 개편
  holidays           String   @default("") // 휴무일 (예: "일요일") — 8.10 개편
  numberPlates       String // 가능한 넘버 방식, 콤마 구분: "개별,법인임대"
  vehicleRequirement String // 차량 조건 (예: "1톤 냉탑")
  initialCapitalMin  Int // 최소 초기 자금 (만원)
  pros               String
  cons               String
  sunTopAvailable    Boolean  @default(true)
  isActive           Boolean  @default(true)
  slotCount          Int      @default(1) // 모집 가능 대수 — 0이면 추천 제외
  introMd            String   @default("") // (사용 중지 — PPT 소개서로 대체)
  center             String   @default("") // 센터 위치 (예: 남사, 안성, 부산 강서구)
  centerAddress      String   @default("") // 센터 상세주소 — 8.10 개편
  externalId         String? // 다우 Work 물량 ID — CSV 재업로드 시 동기화 키
  // 주의: @unique 금지 — 운영 기동 시 prisma db push가 비대화형 확인을 요구해 배포가 실패한다.
  //       유일성은 가져오기 로직(externalId 조회 후 생성/갱신)에서 보장.
  internalMemo       String   @default("") // 내부 참고 (센터 담당자·메모 등, 고객 미노출)
  reviewNote         String   @default("") // CSV 가져오기 후 보완 필요 항목 안내
  deletedAt          DateTime? // 휴지통 (소프트 삭제)
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  recommendations Recommendation[]
  quotes          Quote[] // 센터 소개서 (PPT→PDF 변환본) — 최신 1건이 고객 화면에 표시

  @@index([externalId])
}

// 상담 세션 — 고객 1회 방문 = 1건 (설계서 §6.2)
model Consultation {
  id     String @id @default(cuid())
  status String @default("작성중") // 작성중 → 추천완료 → 접수완료 → 심층상담완료

  // 개인정보
  name         String
  phone        String
  residenceArea String
  age          Int
  drivingYears Int     @default(0)
  cargoYears   Int     @default(0)
  license      String // 보유 면허 (예: "1종 보통")
  hasCargoCert Boolean @default(false) // 화물운송종사자격증

  // 희망 조건
  desiredIncome     Int // 희망 월수입 최소 (만원) — 복수 선택 시 최솟값 (엔진 기준)
  desiredIncomes    String  @default("") // 희망 월수입 복수 선택 원본 (예: "400,500") — 9.7 회의
  desiredRegion     String // 희망 근무지역 — 복수 선택 콤마 구분 (9.7 회의)
  desiredWorkHours  String  @default("")
  shiftAvailability String // 주간 | 야간 | 둘다
  desiredBrand      String  @default("")
  fitnessLevel      Int // 체력 수준 1(약)~5(강)
  initialCapital    Int // 초기 자금 (만원)
  hasVehicle        Boolean @default(false)
  vehiclePreference String  @default("") // 신차 | 중고차 | 해당없음

  // 상담 신청 내용
  interestedIn   String @default("") // (7.20 폼에서 제거 — 과거 데이터 보존용)
  questions      String @default("") // 궁금한 부분
  sunTopSchedule String @default("") // 선탑 '불가능한' 일정 (7.20 변경 — 확정은 다우오피스)
  familyConsent  String @default("") // (7.20 폼에서 제거 — 과거 데이터 보존용)
  notes          String @default("") // (7.20 폼에서 제거 — 과거 데이터 보존용)

  // 7.20 회의 신규 항목
  creditStatus     String @default("") // 신용 상태: 좋음|보통|나쁨|회생|파산
  unavailableTimes String @default("") // 근무 불가 시간 (AI 매칭 참고)
  vehicleTonnage   String @default("") // 보유 차량 톤수
  vehicleBodyType  String @default("") // 보유 차량 탑종류 (윙바디/카고/냉탑/내장탑 등)

  createdAt   DateTime  @default(now())
  completedAt DateTime?
  deletedAt   DateTime? // 휴지통 (소프트 삭제)

  recommendations Recommendation[]
  consents        Consent[]
  videoViews      VideoView[]
}

// AI 추천 결과 (설계서 §6.3) — 추천 근거·사유 원문을 기록으로 보존
model Recommendation {
  id             String @id @default(cuid())
  consultationId String
  listingId      String
  rank           Int
  score          Int
  scoreBreakdown String // JSON — 항목별 득점 근거 (감사 목적)
  reasonText     String // 고객에게 표시된 추천 사유 원문
  reasonSource   String @default("template") // template | openai
  modelId        String @default("") // 사유 생성에 사용한 모델 ID

  consultation Consultation @relation(fields: [consultationId], references: [id])
  listing      Listing      @relation(fields: [listingId], references: [id])
  createdAt    DateTime     @default(now())
}

// 개인정보 동의 이력 (설계서 §6.5)
model Consent {
  id             String   @id @default(cuid())
  consultationId String
  consentType    String // 수집이용 | 제3자제공
  policyVersion  String // 동의 문안 버전
  agreedAt       DateTime @default(now())

  consultation Consultation @relation(fields: [consultationId], references: [id])
}

// 교육영상 (P3 대비 스키마만 선반영, 설계서 §6.4)
model Video {
  id        String   @id @default(cuid())
  title     String
  topic     String // 완제무제매출제 | 넘버방식 | 상하차 | ...
  url       String
  duration  Int      @default(0) // 초
  version   Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  views VideoView[]
}

// 물동량 견적서(센터 소개서) — PPTX 추출→AI 보강→PDF/HTML 렌더 산출물
model Quote {
  id        String   @id @default(cuid())
  brand     String
  center    String
  filename  String
  specJson  String // 24항목 견적 JSON (보강 완료본)
  html      String
  pdf       Bytes
  enriched  Boolean  @default(false) // AI 보강 수행 여부
  modelId   String   @default("") // 보강에 사용한 모델
  listingId String? // 물량에 연결 시 = 그 센터의 소개서 (고객 추천 화면에 표시)
  createdAt DateTime @default(now())

  listing Listing? @relation(fields: [listingId], references: [id])

  @@index([listingId, createdAt])
}

model VideoView {
  id             String    @id @default(cuid())
  consultationId String
  videoId        String
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  completed      Boolean   @default(false)

  consultation Consultation @relation(fields: [consultationId], references: [id])
  video        Video        @relation(fields: [videoId], references: [id])
}
